#!/bin/sh
set -eu

[ "$#" -eq 2 ] || {
    printf 'Usage: screenshot-niri {full|region} OUTPUT\n' >&2
    exit 2
}

mode=$1
output=$2

case "$mode" in
    full)
        exec grim "$output"
        ;;
    region)
        freeze_pid=
        cleanup() {
            if [ -n "$freeze_pid" ] && kill -0 "$freeze_pid" 2>/dev/null; then
                kill "$freeze_pid"
                wait "$freeze_pid" 2>/dev/null || true
            fi
        }
        trap cleanup EXIT HUP INT TERM

        wayfreeze &
        freeze_pid=$!
        sleep 0.1
        geometry=$(slurp)
        grim -g "$geometry" "$output"
        ;;
    *)
        printf 'Unsupported screenshot mode: %s\n' "$mode" >&2
        exit 2
        ;;
esac

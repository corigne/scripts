#!/bin/sh
set -eu

case "${1:-}" in
    --next)
        [ "$#" -eq 1 ] || {
            printf 'Usage: noctalia-wallpaper-random {DIRECTORY|--next}\n' >&2
            exit 2
        }
        action=next
        ;;
    *)
        [ "$#" -eq 1 ] && [ -d "$1" ] || {
            printf 'Usage: noctalia-wallpaper-random {DIRECTORY|--next}\n' >&2
            exit 2
        }
        action=random
        directory=$1
        ;;
esac

runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}
output_list=$runtime_dir/noctalia-outputs.$$

if ! niri_cli=$(command -v niri); then
    printf 'niri CLI not found in PATH\n' >&2
    exit 1
fi
if ! collection_select=$(command -v wallpaper-collection-select); then
    printf 'wallpaper-collection-select not found in PATH\n' >&2
    exit 1
fi
if ! command -v noctalia >/dev/null 2>&1; then
    printf 'noctalia CLI not found in PATH\n' >&2
    exit 1
fi

cleanup() {
    rm -f "$output_list"
}
trap cleanup EXIT HUP INT TERM

if ! outputs=$("$niri_cli" msg -j outputs); then
    printf 'Failed to enumerate niri outputs\n' >&2
    exit 1
fi
if ! printf '%s\n' "$outputs" | jq -r 'keys[]' >"$output_list"; then
    printf 'Invalid output data from niri\n' >&2
    exit 1
fi
if [ ! -s "$output_list" ]; then
    printf 'niri reported no outputs\n' >&2
    exit 1
fi

if [ "$action" = next ]; then
    payload=$("$collection_select" next <"$output_list")
else
    payload=$("$collection_select" random "$directory" <"$output_list")
fi
noctalia msg plugin nexus/mpvpaper:service all apply "$payload"

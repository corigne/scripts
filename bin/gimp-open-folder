#!/bin/sh
# gimp-open-folder: open all images in a folder (one level deep) in a single GIMP instance

folder="$1"

if [ -z "$folder" ]; then
    echo "Usage: gimp-open-folder <folder>" >&2
    exit 1
fi

if [ ! -d "$folder" ]; then
    echo "Error: '$folder' is not a directory" >&2
    exit 1
fi

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
file_list=$(mktemp "$XDG_RUNTIME_DIR/gimp-open-folder.XXXXXX") || exit 1
trap 'rm -f "$file_list"' EXIT HUP INT TERM

find "$folder" -maxdepth 1 -type f \( \
    -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o \
    -iname "*.gif" -o -iname "*.bmp" -o -iname "*.tiff" -o \
    -iname "*.webp" \
    \) -print0 > "$file_list"

if [ ! -s "$file_list" ]; then
    echo "No images found in '$folder'" >&2
    exit 1
fi

xargs -0 gimp < "$file_list"

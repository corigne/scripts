#!/bin/bash

### FUNCTIONS

graceful_shutdown() {
    printf "\nReceived SIGTERM, attempting graceful shutdown."

    if [[ -n ${SLEEP_PID:-} ]] && kill -0 "$SLEEP_PID" 2>/dev/null; then
        kill "$SLEEP_PID"
    fi

    trap - SIGTERM
    exit 0
}

cleanup() {
    if [[ -f $PIDFILE ]] && [[ $(<"$PIDFILE") == "$$" ]]; then
        rm -f "$PIDFILE" "$STATEFILE"
    fi
}

interrupt_sleep() {
    ${DEBUG:-false} && echo "Sleep interrupted, unpausing."
    export PAUSED=false
    if [[ -n ${SLEEP_PID:-} ]] && kill -0 "$SLEEP_PID" 2>/dev/null; then
        kill "$SLEEP_PID"
    fi
}

pause_slideshow() {
    ${DEBUG:-false} && echo "Pausing slideshow."
    export PAUSED=true
    interruptible_sleep 7d
}

restart_slideshow() {
    ${DEBUG:-false} && echo "Restarting slideshow."
    if [[ -n ${SLEEP_PID:-} ]] && kill -0 "$SLEEP_PID" 2>/dev/null; then
        kill "$SLEEP_PID"
    fi
    cleanup
    trap - SIGHUP EXIT
    exec "$0" "${SLIDESHOW_ARGS[@]}"
}

# Replace your sleep with an interruptible version
interruptible_sleep() {
    local duration=$1
    sleep "$duration" &
    SLEEP_PID=$!
    wait "$SLEEP_PID" 2>/dev/null
    local status=$?
    SLEEP_PID=
    return "$status"
}

# Function to get shuffled image list
get_shuffled_images() {
    find "$1" -type f \( \
        -iname '*.avif' -o \
        -iname '*.gif' -o \
        -iname '*.jpeg' -o \
        -iname '*.jpg' -o \
        -iname '*.png' -o \
        -iname '*.webp' \
    \) -print | shuf
}

# Function to process a single wallpaper for a display
process_wallpaper() {
    if "$PAUSED"; then
        printf "Skipping wallpaper paint while slideshow paused."
        return 0
    fi
    local img="$1"
    local display="$2"
    printf "Calling awww img:\n"
    printf "\tImage: $img\n"
    printf "\tDisplay: $display...\n"

    ${VERBOSE:-false} && echo "FIRST_PAINT=$FIRST_PAINT"
    if "$FIRST_PAINT"; then
        transition_type="none"
    else
        transition_type=$TRANSITION
    fi

    # Check if file is a GIF
    if [[ $(file --mime-type -b "$img") == "image/gif" ]]; then
        awww img --filter="$FILTER_TYPE" \
            --transition-type="$transition_type" \
            --transition-fps="$AWWW_TRANSITION_FPS" \
            --resize="$RESIZE_TYPE" \
            --fill-color="$FILL_COLOR" \
            --outputs "$display" "$img"
    else
        local cache_file="$WALLPAPER_CACHE_DIR/${display//[^[:alnum:]_.-]/_}.png"
        if [[ -n $THEME ]]; then
            local -a theme_args=(-t "$THEME")
        else
            local -a theme_args=()
        fi
        if gowall convert "$img" "${theme_args[@]}" --output "$cache_file" --format png; then
            awww img --filter="$FILTER_TYPE" \
                --transition-type="$transition_type" \
                --transition-fps="$AWWW_TRANSITION_FPS" \
                --resize="$RESIZE_TYPE" \
                --fill-color="$FILL_COLOR" \
                --outputs "$display" "$cache_file"
        fi
    fi
}
export -f process_wallpaper
export THEME RESIZE_TYPE FILTER_TYPE TRANSITION FILL_COLOR WALLPAPER_CACHE_DIR

##########################
### SCRIPT LOGIC START ###
##########################
# Multi-monitor wallpaper randomizer with GNU parallel support

# Configuration
export INTERVAL=300
export RESIZE_TYPE="crop"
export FILTER_TYPE="Lanczos3"
export FILL_COLOR="223344"
export TRANSITION="random"
export FIRST_PAINT=true

export AWWW_TRANSITION_FPS=144
export AWWW_TRANSITION_STEP=90

export PAUSED=false
export WALLPAPER_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wayland-slideshow"
mkdir -p "$WALLPAPER_CACHE_DIR"
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
PIDFILE="$XDG_RUNTIME_DIR/awww-slideshow.pid"
STATEFILE="$XDG_RUNTIME_DIR/awww-slideshow-images"
SLEEP_PID=
SLIDESHOW_ARGS=("$@")

trap graceful_shutdown SIGTERM
trap interrupt_sleep SIGUSR1
trap pause_slideshow SIGUSR2
trap restart_slideshow SIGHUP
trap cleanup EXIT

if [[ $# -lt 1 ]] || [[ ! -d $1 ]]; then
    echo "Usage: $0 <dir containing images> [theme]"
    exit 1
fi

# Validate and set theme
THEME=
if [[ -n "$2" ]] && gowall list | grep -Fxq "$2"; then
    THEME=$2
fi
echo "Using theme: $THEME"

# Single instance check
if [[ -e "$PIDFILE" ]]; then
    OLD_PID="$(<$PIDFILE)"
    if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "Another instance is already running (PID: $OLD_PID)"
        exit 1
    fi
fi
echo "No instance of wallpaper script running, continuing with PID: $$."
echo "$$" >"$PIDFILE"

# Ensure awww-daemon is running.
if ! awww query > /dev/null 2>&1; then
    if pgrep -x awww-daemon > /dev/null 2>&1; then
        echo "awww-daemon is running but not responding."
        exit 1
    fi
    echo "awww-daemon not running, starting it..."
    awww-daemon --quiet &
    disown
fi

for ((count = 0; count < 500; count++)); do
    if awww query > /dev/null 2>&1; then
        break
    fi
    sleep 0.01
done
if ! awww query > /dev/null 2>&1; then
    echo "Unable to connect to awww-daemon."
    exit 1
fi

awww restore > /dev/null 2>&1 || true

# Get display list from awww, independent of the compositor.
count=0
until [ ${#DISPLAY_LIST[@]} -ge 1 ]; do
    if [ $count -ge 500 ]; then
        echo "Unable to find a display via awww query."
        exit 1
    fi
    sleep 0.01s

    mapfile -t DISPLAY_LIST < <(awww query | awk -F: 'NF > 1 {print $1}')
    count=$((count + 1))
done

NUM_DISPLAYS=${#DISPLAY_LIST[@]}
echo "Found displays: ${DISPLAY_LIST[*]}"

echo "Starting wallpaper randomizer for ${NUM_DISPLAYS} display(s)"

while true; do
    # Get shuffled list of images
    readarray -t images < <(get_shuffled_images "$1")

    if [[ ${#images[@]} -eq 0 ]]; then
        echo "No images found in $1"
        exit 1
    fi

    # Check if we have enough images for all displays
    if [[ ${#images[@]} -lt $NUM_DISPLAYS ]]; then
        echo "Warning: Only ${#images[@]} images found, but $NUM_DISPLAYS displays detected"
        echo "Some displays will reuse images"
    fi

    # Save current list for reference
    printf '%s\n' "${images[@]}" >"$STATEFILE"

    # Calculate how many complete cycles we can do
    if [[ ${#images[@]} -ge $NUM_DISPLAYS ]]; then
        CYCLES=$((${#images[@]} / NUM_DISPLAYS))
        REMAINDER=$((${#images[@]} % NUM_DISPLAYS))
    else
        CYCLES=1
        REMAINDER=0
    fi

    img_index=0

    # Process complete cycles
    for ((cycle = 0; cycle < CYCLES; cycle++)); do
        echo "Cycle $((cycle + 1))/$CYCLES"

        # Create array of image-display pairs for this cycle
        pairs=()
        current_images=()

        for ((i = 0; i < NUM_DISPLAYS; i++)); do
            current_img="${images[img_index]}"
            current_images+=("$(basename "$current_img")")
            pairs+=("$current_img;${DISPLAY_LIST[i]}")
            ((img_index++))
        done

        echo "Setting wallpapers: ${current_images[*]}"

        # Process all displays in parallel with different images
        printf '%s\n' "${pairs[@]}" |
            parallel --colsep ';' -j "$NUM_DISPLAYS" process_wallpaper {1} {2}

        interruptible_sleep "$INTERVAL"
        if "$FIRST_PAINT"; then
            export -n FIRST_PAINT
            export FIRST_PAINT=false
        fi
    done

    # Handle remaining images if any
    if [[ $REMAINDER -gt 0 ]]; then
        echo "Processing remaining $REMAINDER images"

        pairs=()
        current_images=()

        for ((i = 0; i < REMAINDER; i++)); do
            current_img="${images[img_index]}"
            current_images+=("$(basename "$current_img")")
            pairs+=("$current_img;${DISPLAY_LIST[i]}")
            ((img_index++))
        done
        echo "${pairs[*]}"

        echo "Setting wallpapers: ${current_images[*]}"

        # Process remaining displays in parallel
        printf '%s\n' "${pairs[@]}" |
            parallel --colsep ';' -j "$REMAINDER" process_wallpaper {1} {2}
    fi
    interruptible_sleep "$INTERVAL"
done

#!/bin/bash
# thunar-extract-to-folder: Extract archives each into a named subdirectory (Extract To ./*)
# Usage: thunar-extract-to-folder <file1> [file2 ...]

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
TMPFILE=$(mktemp "$XDG_RUNTIME_DIR/thunar-extract-list.XXXXXX") || exit 1
printf '%s\0' "$@" > "$TMPFILE"

INNER=$(cat << 'INNERSCRIPT'
FAILED=0
NAMES=()

while IFS= read -r -d '' FILE; do
    BASENAME="$(basename "$FILE")"
    DIR="$(dirname "$FILE")"
    # Strip all extensions to get folder name (e.g. archive.tar.gz → archive)
    FOLDERNAME="${BASENAME%%.*}"
    DESTDIR="$DIR/$FOLDERNAME"

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Extracting: $BASENAME"
    echo "  Into:       $DESTDIR"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo

    mkdir -p "$DESTDIR"
    /usr/bin/7z x "$FILE" -o"$DESTDIR"
    EXIT=$?
    echo
    if [ $EXIT -eq 0 ]; then
        echo "✓ Done: $BASENAME → ./$FOLDERNAME/"
        NAMES+=("$FOLDERNAME")
    else
        echo "✗ FAILED: $BASENAME (exit code $EXIT)"
        FAILED=1
    fi
    echo
done < "$1"

rm -f "$1"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -eq 0 ]; then
    COUNT="${#NAMES[@]}"
    echo "  All $COUNT extraction(s) complete."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    /usr/bin/notify-send -i utilities-file-archiver \
        "Extraction Complete" \
        "$COUNT archive(s) extracted to subfolders"
else
    echo "  Some extractions FAILED — see output above."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    /usr/bin/notify-send -u critical -i dialog-error \
        "Extraction Failed" \
        "One or more archives failed to extract"
    echo
    echo "Press Enter to close..."
    read -r
fi
INNERSCRIPT
)

/usr/bin/ghostty --title="Extract To ./*" --class="io.nexus.thunarextract" \
    -e /usr/bin/bash -c "$INNER" thunar-extract-to-folder "$TMPFILE" &

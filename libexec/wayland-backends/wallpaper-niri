#!/bin/sh
set -eu

usage() {
    printf 'Usage: wallpaper-niri {random DIRECTORY|next}\n' >&2
    exit 2
}

[ "$#" -ge 1 ] || usage
action=$1
shift

case "$action" in
    random)
        [ "$#" -eq 1 ] && [ -d "$1" ] || usage
        directory=$1
        ;;
    next)
        [ "$#" -eq 0 ] || usage
        ;;
    *)
        usage
        ;;
esac

runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}
output_list=$runtime_dir/wallpaper-niri-outputs.$$
lock_dir=$runtime_dir/wallpaper-collection.lock

command -v niri >/dev/null 2>&1 || {
    printf 'niri CLI not found in PATH\n' >&2
    exit 1
}
command -v wallpaper-collection-select >/dev/null 2>&1 || {
    printf 'wallpaper-collection-select not found in PATH\n' >&2
    exit 1
}
command -v noctalia >/dev/null 2>&1 || {
    printf 'noctalia CLI not found in PATH\n' >&2
    exit 1
}

if ! mkdir "$lock_dir" 2>/dev/null; then
    printf 'Another wallpaper collection update is already running\n' >&2
    exit 1
fi

cleanup() {
    rm -f "$output_list"
    rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

if ! outputs=$(niri msg -j outputs); then
    printf 'Failed to enumerate niri outputs\n' >&2
    exit 1
fi
if ! printf '%s\n' "$outputs" | jq -r 'keys[]' >"$output_list"; then
    printf 'Invalid output data from niri\n' >&2
    exit 1
fi
if [ ! -s "$output_list" ]; then
    printf 'niri reported no outputs\n' >&2
    exit 1
fi

if [ "$action" = next ]; then
    payload=$(wallpaper-collection-select next <"$output_list")
else
    payload=$(wallpaper-collection-select random "$directory" <"$output_list")
fi
noctalia msg plugin nexus/mpvpaper:service all apply "$payload"

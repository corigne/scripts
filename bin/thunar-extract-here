#!/bin/bash
# thunar-extract-here: Extract archives to their own directory (Extract Here)
# Usage: thunar-extract-here <file1> [file2 ...]

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
TMPFILE=$(mktemp "$XDG_RUNTIME_DIR/thunar-extract-list.XXXXXX") || exit 1
printf '%s\0' "$@" > "$TMPFILE"

INNER=$(cat << 'INNERSCRIPT'
FAILED=0
NAMES=()

while IFS= read -r -d '' FILE; do
    BASENAME="$(basename "$FILE")"
    DIR="$(dirname "$FILE")"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Extracting: $BASENAME"
    echo "  Into:       $DIR"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo
    /usr/bin/7z x "$FILE" -o"$DIR"
    EXIT=$?
    echo
    if [ $EXIT -eq 0 ]; then
        echo "✓ Done: $BASENAME"
        NAMES+=("$BASENAME")
    else
        echo "✗ FAILED: $BASENAME (exit code $EXIT)"
        FAILED=1
    fi
    echo
done < "$1"

rm -f "$1"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -eq 0 ]; then
    COUNT="${#NAMES[@]}"
    echo "  All $COUNT extraction(s) complete."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    /usr/bin/notify-send -i utilities-file-archiver \
        "Extraction Complete" \
        "$COUNT archive(s) extracted successfully"
else
    echo "  Some extractions FAILED — see output above."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    /usr/bin/notify-send -u critical -i dialog-error \
        "Extraction Failed" \
        "One or more archives failed to extract"
    echo
    echo "Press Enter to close..."
    read -r
fi
INNERSCRIPT
)

/usr/bin/ghostty --title="Extract Here" --class="io.nexus.thunarextract" \
    -e /usr/bin/bash -c "$INNER" thunar-extract-here "$TMPFILE" &
